# Local testing only. Production runs on GitHub Actions, where these are repo
# secrets (Settings → Secrets and variables → Actions). See docs/SETUP.md.

# --- YouTube OAuth ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Behavior ---
# Multiple titles separated by ||
BASE_TITLES=Lễ thờ phượng - Worship Service - Hội Thánh Tin Lành Ân Điển
TIMEZONE=America/Los_Angeles
RECENT_WINDOW_DAYS=7
# Set true to preview without writing changes
DRY_RUN=true
LOG_LEVEL=INFO
